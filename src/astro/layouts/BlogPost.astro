---
import type { ImageMetadata, MarkdownHeading } from 'astro';
import { SITE_TITLE } from '../../consts';
import { getSortedPosts } from '../../lib/posts';
import TableOfContents from '../components/TableOfContents.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: ImageMetadata;
  category?: 'tech' | 'life';
  subcategory?: string;
  tags?: string[];
  locale?: 'ko' | 'en';
  // 한/영 번역 짝이 있을 때만 채움 → hreflang + 본문 상단 언어 전환 링크
  alternates?: { ko: string; en: string };
  // 미번역 글의 /en/ 페이지 — 한국어 원문을 렌더하되 안내 박스 + canonical→원문
  fallback?: boolean;
  // 빌드 때 생성한 OG 카드 경로 (`/og/<slug>.png`)
  ogImagePath?: string;
  // 목차용 제목 목록. 항목이 3개 미만이면 컴포넌트가 알아서 렌더하지 않는다.
  headings?: MarkdownHeading[];
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  category,
  subcategory,
  tags = [],
  locale = 'ko',
  alternates,
  fallback = false,
  ogImagePath,
  headings = [],
} = Astro.props;

// 폴백 페이지는 URL 만 /en/ 이고 내용은 한국어 — 문서 언어·canonical·JSON-LD 는 원문 기준
const contentLang = fallback ? 'ko' : locale;
const tocLabel = contentLang === 'en' ? 'Contents' : '목차';
const koPath = Astro.url.pathname.replace(/^\/en\//, '/');
const langAltHref = locale === 'en' ? koPath : `/en${Astro.url.pathname}`;
const categoryLabel = category === 'tech' ? 'Tech' : category === 'life' ? 'Life' : null;
const prefix = locale === 'en' ? '/en' : '';
const categoryHref =
  category === 'tech' ? `${prefix}/tech` : category === 'life' ? `${prefix}/life` : null;

// en 모드에선 실제로 존재하는 영어 서브카테고리·태그 페이지만 링크 — 폴백 글에서의 404 방지
let enSubcats: Set<string | undefined> | null = null;
let enTags: Set<string> | null = null;
if (locale === 'en') {
  const enPosts = await getSortedPosts('en');
  enSubcats = new Set(enPosts.map((p) => p.data.subcategory).filter(Boolean));
  enTags = new Set(enPosts.flatMap((p) => p.data.tags));
}
const subcategoryHref = !subcategory
  ? null
  : locale === 'en'
    ? enSubcats?.has(subcategory)
      ? `/en/tech/${subcategory}/`
      : null
    : `/tech/${subcategory}/`;
const visibleTags = locale === 'en' ? tags.filter((t) => enTags?.has(t)) : tags;

// 구조화 데이터(schema.org BlogPosting) — frontmatter 로 자동 생성. 글마다 수동 추가 불필요.
// 새 글은 title·description·pubDate 만 있으면 자동으로 붙고, updatedDate/heroImage/tags 는 있으면 반영.
const canonicalURL = new URL(fallback ? koPath : Astro.url.pathname, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Organization', name: SITE_TITLE, url: new URL('/', Astro.site).href },
  publisher: {
    '@type': 'Organization',
    name: SITE_TITLE,
    logo: { '@type': 'ImageObject', url: new URL('/favicon-192.png', Astro.site).href },
  },
  url: canonicalURL,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
  inLanguage: contentLang === 'en' ? 'en' : 'ko-KR',
  // image 는 실제 대표 이미지(heroImage)가 있을 때만. 없으면 생략(권장 항목이라 무방)
  // — 작은 favicon 을 넣으면 리치결과에서 "이미지 너무 작음" 경고가 나므로 넣지 않음.
  ...(heroImage ? { image: new URL(heroImage.src, Astro.site).href } : {}),
  ...(categoryLabel ? { articleSection: categoryLabel } : {}),
  ...(tags.length ? { keywords: tags.join(', ') } : {}),
};
// set:html 로 주입하므로 </script> 조기 종료 방지를 위해 < 를 유니코드 이스케이프.
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<html lang={contentLang}>
  <head>
    <BaseHead
      title={title}
      description={description}
      alternates={alternates}
      canonicalPath={fallback ? koPath : undefined}
      ogImagePath={ogImagePath}
      contentLang={contentLang}
      ogType="article"
      article={{
        publishedTime: pubDate.toISOString(),
        modifiedTime: (updatedDate ?? pubDate).toISOString(),
        section: categoryLabel ?? undefined,
        tags,
      }}
    />
    <script type="application/ld+json" is:inline set:html={jsonLdText} />
  </head>
  <body>
    <Header locale={locale} altHref={langAltHref} />
    {/*
      넓은 화면(xl↑)에서만 3칸 격자: [빈 칸 16rem][본문 48rem][목차 16rem] = 80rem.
      좌우 칸을 같은 폭으로 둬야 본문이 화면 정중앙에 남는다 — 목록 페이지에서
      글로 넘어올 때 본문 위치가 움직이지 않게 하기 위함.
      목차 칸의 실제 패널은 왼쪽 여백 2rem 을 빼고 14rem 을 쓴다.
    */}
    <div class="toc:mx-auto toc:grid toc:max-w-[80rem] toc:grid-cols-[16rem_48rem_16rem]">
      <div class="hidden toc:block" aria-hidden="true"></div>
      <main class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
      {/* 폴백 페이지는 검색 인덱스 제외 — 원문과 같은 한국어 내용이라 중복 노출 방지 */}
      <article
        {...(fallback ? {} : { 'data-pagefind-body': true })}
        data-pagefind-meta={`category:${category ?? ''}`}
      >
        <header class="mb-10 pb-8 border-b border-slate-200 dark:border-slate-800">
          {categoryLabel && categoryHref && (
            <div class="mb-4 flex items-center gap-1.5">
              <a
                href={categoryHref}
                class="inline-block text-xs font-medium px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors"
              >
                {categoryLabel}
              </a>
              {subcategory && (
                <>
                  <span class="text-xs text-slate-400 dark:text-slate-600">›</span>
                  {subcategoryHref ? (
                    <a
                      href={subcategoryHref}
                      class="inline-block text-xs font-medium px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors"
                    >
                      {subcategory}
                    </a>
                  ) : (
                    <span class="inline-block text-xs font-medium px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                      {subcategory}
                    </span>
                  )}
                </>
              )}
            </div>
          )}
          <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-slate-100 mb-4 leading-tight">
            {title}
          </h1>
          <div class="text-sm text-slate-500 dark:text-slate-400 flex items-center gap-3">
            <FormattedDate date={pubDate} />
            {updatedDate && updatedDate.valueOf() > pubDate.valueOf() && (
              <span class="italic">· updated <FormattedDate date={updatedDate} /></span>
            )}
            {alternates && (
              <a
                href={locale === 'en' ? alternates.ko : alternates.en}
                class="text-(--color-accent) hover:underline underline-offset-2"
              >
                {locale === 'en' ? '🌐 한국어로 보기' : '🌐 Read in English'}
              </a>
            )}
          </div>
        </header>

        {fallback && (
          <div class="mb-8 rounded-lg border border-amber-300 dark:border-amber-700/60 bg-amber-50 dark:bg-amber-950/40 px-4 py-3 text-sm text-amber-900 dark:text-amber-200">
            🌐 This post hasn't been translated into English yet — you're reading the Korean
            original.
            <a
              href="/en/"
              class="underline underline-offset-2 hover:text-amber-700 dark:hover:text-amber-100"
            >
              Browse posts in English →
            </a>
          </div>
        )}

        {/* 좁은 화면에서는 목차 칸이 없으므로 본문 위 접힘 블록으로 */}
        <div class="toc:hidden">
          <TableOfContents headings={headings} variant="inline" label={tocLabel} />
        </div>

        {/* heroImage 는 목록 썸네일 용도로만 사용 — 본문 상단에는 렌더하지 않음 */}
        <div class="prose prose-slate dark:prose-invert max-w-none prose-headings:scroll-mt-20 prose-a:text-(--color-accent) prose-a:no-underline hover:prose-a:underline prose-code:before:hidden prose-code:after:hidden prose-code:bg-slate-100 dark:prose-code:bg-slate-800 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:font-normal prose-img:rounded-lg">
          <slot />
        </div>

        {visibleTags.length > 0 && (
          <footer class="mt-12 pt-8 border-t border-slate-200 dark:border-slate-800">
            <div class="flex flex-wrap gap-2">
              {visibleTags.map((tag) => (
                <a
                  href={`${prefix}/tags/${tag}/`}
                  class="inline-block text-sm px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors"
                >
                  #{tag}
                </a>
              ))}
            </div>
          </footer>
        )}
      </article>
      </main>
      <div class="hidden toc:block">
        <TableOfContents headings={headings} variant="sidebar" label={tocLabel} />
      </div>
    </div>
    <Footer />

    <script>
      import '../../lib/lightbox';
      import '../../lib/mermaid-client';
    </script>
  </body>
</html>
