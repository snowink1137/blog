---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  /** 좁은 화면에서 접힘 블록에 쓸 라벨 */
  label?: string;
}

const { headings, label = '목차' } = Astro.props;

// h2·h3 만 (h4 이하는 목차가 너무 잘게 쪼개진다)
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length >= 3 && (
    <>
      {/* 넓은 화면: 본문 오른쪽 여백에 고정. 본문 폭(48rem)을 건드리지 않으려고
          가운데 기준으로 밀어낸다. 1280px 미만에서는 숨김. */}
      <nav
        aria-label={label}
        data-toc
        class="hidden xl:block fixed top-24 left-[calc(50%+25rem)] w-56 max-h-[70vh] overflow-y-auto"
      >
        <p class="text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-3">
          {label}
        </p>
        <ul class="space-y-1.5 border-l border-slate-200 dark:border-slate-800">
          {items.map((h) => (
            <li>
              <a
                href={`#${h.slug}`}
                data-toc-link={h.slug}
                class:list={[
                  'block border-l -ml-px py-0.5 text-sm leading-snug border-transparent text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 transition-colors',
                  h.depth === 2 ? 'pl-3' : 'pl-6',
                ]}
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      {/* 좁은 화면: 본문 위 접힘 블록 */}
      <details class="xl:hidden mb-8 rounded-lg border border-slate-200 dark:border-slate-800 not-prose">
        <summary class="cursor-pointer select-none px-4 py-3 text-sm font-medium text-slate-700 dark:text-slate-300">
          {label}
        </summary>
        <ul class="px-4 pb-3 space-y-1.5">
          {items.map((h) => (
            <li>
              <a
                href={`#${h.slug}`}
                class:list={[
                  'block text-sm text-slate-600 dark:text-slate-400 hover:text-(--color-accent)',
                  h.depth === 3 && 'pl-4',
                ]}
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </details>
    </>
  )
}

<script>
  // 스크롤 위치에 따라 목차에서 현재 섹션을 강조한다.
  const nav = document.querySelector<HTMLElement>('[data-toc]');
  if (nav) {
    const links = new Map<string, HTMLAnchorElement>();
    nav.querySelectorAll<HTMLAnchorElement>('[data-toc-link]').forEach((a) => {
      links.set(a.dataset.tocLink!, a);
    });
    const targets = [...links.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    let current: HTMLAnchorElement | null = null;
    const setActive = (id: string | null) => {
      const next = id ? (links.get(id) ?? null) : null;
      if (next === current) return;
      current?.removeAttribute('data-active');
      next?.setAttribute('data-active', '');
      current = next;
    };

    const update = () => {
      // 화면 상단(헤더 높이 감안)보다 위에 있는 마지막 제목이 현재 섹션
      const line = 96;
      let active: string | null = null;
      for (const el of targets) {
        if (el.getBoundingClientRect().top <= line) active = el.id;
        else break;
      }
      // 아직 첫 제목에 도달하지 않았으면 첫 항목을 강조
      setActive(active ?? targets[0]?.id ?? null);
    };

    update();
    let ticking = false;
    addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          update();
          ticking = false;
        });
      },
      { passive: true },
    );
  }
</script>
