---
import '../../styles/global.css';
import { SITE_TITLE } from '../../consts';
import Ads from './Ads.astro';
import Analytics from './Analytics.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  // 한/영 번역 짝이 있는 페이지만 채움 → hreflang alternate 링크 출력 (양쪽이 같은 세트를 가져야 유효)
  alternates?: { ko: string; en: string };
  // 자기 자신이 대표 URL 이 아닐 때(미번역 글의 /en/ 폴백 등) canonical 을 이 경로로 지정
  canonicalPath?: string;
  // 빌드 때 생성한 OG 카드 경로 (`/og/<slug>.png`). 글 페이지가 넘겨줌.
  // 없으면 언어별 사이트 공용 카드를 쓴다.
  ogImagePath?: string;
  // 본문의 실제 언어. 미번역 글의 /en/ 폴백은 경로가 /en/ 여도 내용이 한국어라 'ko' 를 넘긴다.
  contentLang?: 'ko' | 'en';
  ogType?: 'website' | 'article';
  // 글일 때만 채워짐 → og:type=article + article:* 하위 태그 출력
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    section?: string;
    tags?: string[];
  };
}

const {
  title,
  description,
  noindex = false,
  alternates,
  canonicalPath,
  ogImagePath,
  contentLang,
  ogType = 'website',
  article,
} = Astro.props;
const canonicalURL = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
// /en/ 경로에서는 RSS 자동발견이 영어 피드를 가리키도록
const isEnPath = Astro.url.pathname === '/en/' || Astro.url.pathname.startsWith('/en/');
// 공유 카드: 글은 전용 카드, 그 외에는 언어별 사이트 공용 카드
const ogImageURL = new URL(ogImagePath ?? (isEnPath ? '/og/en/site.png' : '/og/site.png'), Astro.site);
// SNS 스크래퍼(카카오·페북 등)가 언어를 판단할 근거. 없으면 hreflang 을 보고 반대 언어판을 집어올 수 있다.
const ogLocale = (contentLang ?? (isEnPath ? 'en' : 'ko')) === 'en' ? 'en_US' : 'ko_KR';
const ogLocaleAlt = ogLocale === 'en_US' ? 'ko_KR' : 'en_US';
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={isEnPath ? `${SITE_TITLE} — English` : SITE_TITLE}
	href={new URL(isEnPath ? 'en/rss.xml' : 'rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

{/* 얇은 아카이브(태그·페이지네이션)는 색인 제외하되 링크는 따라가게 (crawl equity 보존) */}
{noindex && <meta name="robots" content="noindex, follow" />}

<!-- 검색엔진 소유권 확인 (워프에서 이관) -->
<meta name="google-site-verification" content="uhoTDC6qz332q6wtVvyZJyw4N_SxOvOexkXM6RydxrA" />
<meta name="naver-site-verification" content="b275c4ec23e8aed1ba518d0eacb4bccf3d664830" />

<Analytics />
<Ads />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

{/* 한/영 번역 짝 — 검색엔진이 검색자 언어에 맞는 URL 을 노출하도록. x-default 는 그 외 언어권용 */}
{alternates && (
  <>
    <link rel="alternate" hreflang="ko" href={new URL(alternates.ko, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(alternates.en, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.ko, Astro.site)} />
  </>
)}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={ogLocale} />
{alternates && <meta property="og:locale:alternate" content={ogLocaleAlt} />}
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{ogType === 'article' && article && (
  <>
    {article.publishedTime && (
      <meta property="article:published_time" content={article.publishedTime} />
    )}
    {article.modifiedTime && (
      <meta property="article:modified_time" content={article.modifiedTime} />
    )}
    {article.section && <meta property="article:section" content={article.section} />}
    {(article.tags ?? []).map((t) => (
      <meta property="article:tag" content={t} />
    ))}
  </>
)}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImageURL} />

<script is:inline>
  (() => {
    const stored = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const isDark = stored === 'dark' || (!stored && prefersDark);
    document.documentElement.classList.add(isDark ? 'dark' : 'light');
  })();
</script>
