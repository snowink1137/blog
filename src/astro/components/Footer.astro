---
const today = new Date();
// 언어 모드는 URL 이 곧 상태 — /en/ 하위면 푸터 링크도 영어 페이지·영어 피드로
const isEn = Astro.url.pathname === '/en/' || Astro.url.pathname.startsWith('/en/');
const prefix = isEn ? '/en' : '';
---

<footer class="border-t border-slate-200 dark:border-slate-800 mt-16">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-8 text-sm text-slate-500 dark:text-slate-400 flex flex-col sm:flex-row items-center justify-between gap-4">
    <p>&copy; {today.getFullYear()} hello world log</p>
    <div class="flex items-center gap-4">
      <a href={`${prefix}/about`} class="hover:text-slate-900 dark:hover:text-slate-100 transition-colors">About</a>
      <a href={`${prefix}/privacy-policy`} class="hover:text-slate-900 dark:hover:text-slate-100 transition-colors">Privacy Policy</a>
      <a href={`${prefix}/rss.xml`} class="hover:text-slate-900 dark:hover:text-slate-100 transition-colors">RSS</a>
    </div>
  </div>
</footer>
