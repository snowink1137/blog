---
// Google Analytics(GA4) — 프로덕션 빌드 + 실제 서비스 도메인에서만 동작.
//  - import.meta.env.PROD: 로컬 dev 는 제외 (빌드 시점 가드)
//  - location.hostname === 프로덕션 호스트(Astro.site): 프리뷰·스테이징
//    도메인 트래픽이 실제 GA 속성에 섞이지 않도록 (런타임 가드)
import { GA_MEASUREMENT_ID } from '../../consts';

const enabled = import.meta.env.PROD;
const gaId = GA_MEASUREMENT_ID;
const prodHost = Astro.site ? new URL(Astro.site).hostname : '';
---

{enabled && gaId && (
  <script define:vars={{ gaId, prodHost }}>
    if (!prodHost || location.hostname === prodHost) {
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', gaId);
    }
  </script>
)}
