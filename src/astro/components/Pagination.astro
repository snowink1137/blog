---
interface Props {
  currentPage: number;
  totalPages: number;
}

const { currentPage, totalPages } = Astro.props;
const hrefFor = (n: number) => (n === 1 ? '/' : `/page/${n}/`);
const pages = Array.from({ length: totalPages }, (_, i) => i + 1);
---

{totalPages > 1 && (
  <nav class="mt-12 flex items-center justify-center gap-1" aria-label="페이지 이동">
    {currentPage > 1 && (
      <a
        href={hrefFor(currentPage - 1)}
        class="px-3 py-1.5 rounded-md text-sm text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
        aria-label="이전 페이지"
      >
        ←
      </a>
    )}
    {pages.map((n) =>
      n === currentPage ? (
        <span
          class="px-3 py-1.5 rounded-md text-sm font-semibold bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-900"
          aria-current="page"
        >
          {n}
        </span>
      ) : (
        <a
          href={hrefFor(n)}
          class="px-3 py-1.5 rounded-md text-sm text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
        >
          {n}
        </a>
      ),
    )}
    {currentPage < totalPages && (
      <a
        href={hrefFor(currentPage + 1)}
        class="px-3 py-1.5 rounded-md text-sm text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
        aria-label="다음 페이지"
      >
        →
      </a>
    )}
  </nav>
)}
