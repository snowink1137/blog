---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  /** 기본 /<id>/ 대신 쓸 링크 — 영어 목록에서 /en/ 프리픽스 URL 로 보낼 때 사용 */
  href?: string;
  /** 카테고리 칩 옆 보조 배지 — 영어 목록의 미번역(KO) 표시 등 */
  badge?: string;
}

const { post, href = `/${post.id}/`, badge } = Astro.props;
const categoryLabel = post.data.category === 'tech' ? 'Tech' : 'Life';
---

<a href={href} class="group block">
  <article class="flex items-center justify-between gap-4 sm:gap-5">
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2 mb-2">
        <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
          {categoryLabel}
        </span>
        {badge && (
          <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-amber-100 dark:bg-amber-900/40 text-amber-800 dark:text-amber-300">
            {badge}
          </span>
        )}
        <span class="text-xs text-slate-500 dark:text-slate-500">
          <FormattedDate date={post.data.pubDate} />
        </span>
      </div>
      <h2 class="text-lg sm:text-xl font-semibold text-slate-900 dark:text-slate-100 group-hover:text-(--color-accent) transition-colors mb-2 leading-snug line-clamp-2">
        {post.data.title}
      </h2>
      {post.data.description && (
        <p class="text-sm text-slate-600 dark:text-slate-400 line-clamp-2">
          {post.data.description}
        </p>
      )}
    </div>
    {post.data.heroImage && (
      <div class="w-20 sm:w-36 shrink-0">
        <Image
          width={288}
          height={288}
          src={post.data.heroImage}
          alt=""
          class="w-full aspect-square sm:aspect-[3/2] object-cover rounded-lg"
        />
      </div>
    )}
  </article>
</a>
