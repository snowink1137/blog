---
import BaseHead from '../astro/components/BaseHead.astro';
import Footer from '../astro/components/Footer.astro';
import Header from '../astro/components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="ko">
  <head>
    <BaseHead title={`404 | ${SITE_TITLE}`} description="페이지를 찾을 수 없습니다" noindex />
  </head>
  <body>
    <Header />
    <main class="max-w-content mx-auto px-4 sm:px-6 py-24 sm:py-32 text-center">
      <p class="text-7xl sm:text-8xl font-bold tracking-tight text-slate-200 dark:text-slate-700">
        404
      </p>
      <h1 class="mt-4 text-2xl sm:text-3xl font-bold text-slate-900 dark:text-slate-100">
        페이지를 찾을 수 없습니다
      </h1>
      <p class="mt-3 text-slate-600 dark:text-slate-400">
        주소가 바뀌었거나 삭제된 페이지일 수 있어요.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/"
          class="inline-flex items-center rounded-lg bg-(--color-accent) px-5 py-2.5 text-sm font-medium text-white dark:text-slate-900 hover:bg-(--color-accent-hover) transition-colors"
        >
          홈으로
        </a>
        <a
          href="/search/"
          class="inline-flex items-center rounded-lg border border-slate-300 dark:border-slate-700 px-5 py-2.5 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
        >
          검색
        </a>
      </div>
    </main>
    <Footer />
  </body>
</html>
