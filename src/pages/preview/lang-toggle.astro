---
import BaseHead from '../../astro/components/BaseHead.astro';
import { SITE_TITLE } from '../../consts';

// 언어 토글 디자인 후보 미리보기 (2차: 풀네임 표기) — 선택 후 삭제 예정. noindex + sitemap 제외(/preview/).
---

<!doctype html>
<html lang="ko">
  <head>
    <BaseHead title={`언어 토글 디자인 후보 2차 | ${SITE_TITLE}`} description="디자인 미리보기" noindex />
  </head>
  <body class="bg-slate-50 dark:bg-slate-900">
    <main class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
      <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-2">언어 토글 후보 2차 — 풀네임 표기</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400 mb-10">
        고른 ②③④⑤를 "English / 한국어" 풀네임으로 바꿔봤어. 왼쪽 = 한국어 페이지, 오른쪽 = 영어 페이지.
        모바일 폭이 궁금하면 창을 좁혀서 봐줘. 다크모드 전환도 해보고.
      </p>

      <div class="space-y-10">
        <!-- ② 지구본 + 목적지 단어 -->
        <section>
          <h2 class="font-semibold text-slate-900 dark:text-slate-100 mb-1">② 지구본 + 목적지 단어</h2>
          <p class="text-sm text-slate-500 dark:text-slate-400 mb-3">"누르면 가는 언어"를 그 언어로 표기 (GitHub 방식). 컴팩트하면서 오해 여지 없음.</p>
          <div class="flex gap-4">
            <div class="flex-1 flex items-center justify-end gap-5 h-14 px-4 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-500 dark:text-slate-400"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
              <a href="#" class="flex items-center gap-1.5 text-sm text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100 transition-colors"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path><path d="M2 12h20"></path></svg>English</a>
              <span class="text-slate-500 dark:text-slate-400">🌓</span>
            </div>
            <div class="flex-1 flex items-center justify-end gap-5 h-14 px-4 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-500 dark:text-slate-400"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
              <a href="#" class="flex items-center gap-1.5 text-sm text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100 transition-colors"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path><path d="M2 12h20"></path></svg>한국어</a>
              <span class="text-slate-500 dark:text-slate-400">🌓</span>
            </div>
          </div>
        </section>

        <!-- ③ 타이포 슬래시 -->
        <section>
          <h2 class="font-semibold text-slate-900 dark:text-slate-100 mb-1">③ 타이포그래피 슬래시</h2>
          <p class="text-sm text-slate-500 dark:text-slate-400 mb-3">두 언어가 다 보이고 현재 언어가 진하게. 테두리 없이 가장 가벼움.</p>
          <div class="flex gap-4">
            <div class="flex-1 flex items-center justify-end gap-5 h-14 px-4 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-500 dark:text-slate-400"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
              <a href="#" class="text-sm"><span class="font-semibold text-slate-900 dark:text-slate-100">한국어</span><span class="text-slate-300 dark:text-slate-600 mx-1.5">/</span><span class="text-slate-400 dark:text-slate-500 hover:text-slate-700 dark:hover:text-slate-300 transition-colors">English</span></a>
              <span class="text-slate-500 dark:text-slate-400">🌓</span>
            </div>
            <div class="flex-1 flex items-center justify-end gap-5 h-14 px-4 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-500 dark:text-slate-400"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
              <a href="#" class="text-sm"><span class="text-slate-400 dark:text-slate-500 hover:text-slate-700 dark:hover:text-slate-300 transition-colors">한국어</span><span class="text-slate-300 dark:text-slate-600 mx-1.5">/</span><span class="font-semibold text-slate-900 dark:text-slate-100">English</span></a>
              <span class="text-slate-500 dark:text-slate-400">🌓</span>
            </div>
          </div>
        </section>

        <!-- ④ 언더라인 탭 -->
        <section>
          <h2 class="font-semibold text-slate-900 dark:text-slate-100 mb-1">④ 언더라인 탭</h2>
          <p class="text-sm text-slate-500 dark:text-slate-400 mb-3">현재 언어에 악센트색 밑줄. 상태 표시가 가장 뚜렷함.</p>
          <div class="flex gap-4">
            <div class="flex-1 flex items-center justify-end gap-5 h-14 px-4 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-500 dark:text-slate-400"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
              <a href="#" class="flex items-center gap-3 text-sm"><span class="font-medium text-slate-900 dark:text-slate-100 border-b-2 border-(--color-accent) pb-0.5">한국어</span><span class="text-slate-400 dark:text-slate-500 border-b-2 border-transparent pb-0.5 hover:text-slate-700 dark:hover:text-slate-300 transition-colors">English</span></a>
              <span class="text-slate-500 dark:text-slate-400">🌓</span>
            </div>
            <div class="flex-1 flex items-center justify-end gap-5 h-14 px-4 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-500 dark:text-slate-400"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
              <a href="#" class="flex items-center gap-3 text-sm"><span class="text-slate-400 dark:text-slate-500 border-b-2 border-transparent pb-0.5 hover:text-slate-700 dark:hover:text-slate-300 transition-colors">한국어</span><span class="font-medium text-slate-900 dark:text-slate-100 border-b-2 border-(--color-accent) pb-0.5">English</span></a>
              <span class="text-slate-500 dark:text-slate-400">🌓</span>
            </div>
          </div>
        </section>

        <!-- ⑤ 단어 링크 단독 -->
        <section>
          <h2 class="font-semibold text-slate-900 dark:text-slate-100 mb-1">⑤ 목적지 단어 링크 단독</h2>
          <p class="text-sm text-slate-500 dark:text-slate-400 mb-3">가장 짧음. 대신 현재 상태 표시는 없음 (URL/콘텐츠가 알려주긴 함).</p>
          <div class="flex gap-4">
            <div class="flex-1 flex items-center justify-end gap-5 h-14 px-4 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-500 dark:text-slate-400"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
              <a href="#" class="text-sm text-slate-600 dark:text-slate-300 hover:text-(--color-accent) transition-colors">English</a>
              <span class="text-slate-500 dark:text-slate-400">🌓</span>
            </div>
            <div class="flex-1 flex items-center justify-end gap-5 h-14 px-4 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-500 dark:text-slate-400"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
              <a href="#" class="text-sm text-slate-600 dark:text-slate-300 hover:text-(--color-accent) transition-colors">한국어</a>
              <span class="text-slate-500 dark:text-slate-400">🌓</span>
            </div>
          </div>
        </section>
      </div>
    </main>
  </body>
</html>
