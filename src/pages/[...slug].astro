---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../astro/layouts/BlogPost.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  // en/ 하위는 영어 번역본 — id 가 'en/<slug>' 라 URL 도 자동으로 /en/<slug>/ 가 된다.
  // 번역 짝이 있는 글만 alternates(hreflang 쌍)를 넘긴다.
  // 번역이 없는 한국어 글은 /en/<slug>/ 폴백 페이지를 추가 생성 (원문 렌더 + canonical→원문).
  const enIds = new Set(posts.filter((p) => p.id.startsWith('en/')).map((p) => p.id.slice(3)));
  const paths = [];
  for (const post of posts) {
    const isEn = post.id.startsWith('en/');
    const baseId = isEn ? post.id.slice(3) : post.id;
    const paired = isEn || enIds.has(post.id);
    paths.push({
      params: { slug: post.id },
      props: {
        post,
        locale: isEn ? ('en' as const) : ('ko' as const),
        alternates: paired ? { ko: `/${baseId}/`, en: `/en/${baseId}/` } : undefined,
        fallback: false,
      },
    });
    if (!isEn && !paired) {
      paths.push({
        params: { slug: `en/${post.id}` },
        props: { post, locale: 'en' as const, alternates: undefined, fallback: true },
      });
    }
  }
  return paths;
}
type Props = {
  post: CollectionEntry<'blog'>;
  locale: 'ko' | 'en';
  alternates?: { ko: string; en: string };
  fallback: boolean;
};

const { post, locale, alternates, fallback } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} locale={locale} alternates={alternates} fallback={fallback}>
  <Content />
</BlogPost>
