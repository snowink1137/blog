---
import BaseHead from '../../../astro/components/BaseHead.astro';
import Footer from '../../../astro/components/Footer.astro';
import Header from '../../../astro/components/Header.astro';
import PostCard from '../../../astro/components/PostCard.astro';
import { SITE_TITLE } from '../../../consts';
import { getSortedPosts } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getSortedPosts('en');
  const tagSet = new Set<string>();
  for (const post of posts) {
    for (const tag of post.data.tags) tagSet.add(tag);
  }
  return Array.from(tagSet).map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((p) => p.data.tags.includes(tag)),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`#${tag} | ${SITE_TITLE}`} description={`Posts tagged ${tag}`} noindex />
  </head>
  <body>
    <Header locale="en" altHref={`/tags/${tag}/`} />
    <main class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
      <header class="mb-10">
        <p class="text-sm text-slate-500 dark:text-slate-400 mb-2">
          <a href="/en/tags/" class="hover:text-slate-900 dark:hover:text-slate-100 transition-colors">← All tags</a>
        </p>
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-slate-100 mb-2">
          #{tag}
        </h1>
        <p class="text-slate-600 dark:text-slate-400">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
      </header>
      <ul class="divide-y divide-slate-100 dark:divide-slate-800/70">
        {posts.map((post) => (
          <li class="py-6 first:pt-0 last:pb-0">
            <PostCard post={post} />
          </li>
        ))}
      </ul>
    </main>
    <Footer />
  </body>
</html>
