---
import BaseHead from '../../astro/components/BaseHead.astro';
import Footer from '../../astro/components/Footer.astro';
import Header from '../../astro/components/Header.astro';
import PostCard from '../../astro/components/PostCard.astro';
import { SITE_TITLE } from '../../consts';
import { getSortedPosts } from '../../lib/posts';

const posts = (await getSortedPosts('en')).filter((post) => post.data.category === 'life');
---

<!doctype html>
<html lang="en">
  <head>
    {/* 번역된 life 글이 없는 동안은 빈 페이지라 noindex. 글이 생기면 자동으로 색인 허용 + 짝 선언 */}
    <BaseHead
      title={`Life | ${SITE_TITLE}`}
      description="Everyday life and notes"
      noindex={posts.length === 0}
      alternates={posts.length > 0 ? { ko: '/life/', en: '/en/life/' } : undefined}
    />
  </head>
  <body>
    <Header locale="en" altHref="/life/" />
    <main class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
      <header class="mb-10">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-slate-100 mb-2">Life</h1>
        <p class="text-slate-600 dark:text-slate-400">Everyday life and notes · {posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
      </header>
      {posts.length === 0 ? (
        <p class="text-slate-500 dark:text-slate-400">
          No Life posts have been translated into English yet.
          <a href="/en/" class="text-(--color-accent) hover:underline underline-offset-2">Browse tech posts →</a>
        </p>
      ) : (
        <ul class="divide-y divide-slate-100 dark:divide-slate-800/70">
          {posts.map((post) => (
            <li class="py-6 first:pt-0 last:pb-0">
              <PostCard post={post} />
            </li>
          ))}
        </ul>
      )}
    </main>
    <Footer />
  </body>
</html>
