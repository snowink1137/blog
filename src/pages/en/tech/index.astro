---
import BaseHead from '../../../astro/components/BaseHead.astro';
import Footer from '../../../astro/components/Footer.astro';
import Header from '../../../astro/components/Header.astro';
import PostCard from '../../../astro/components/PostCard.astro';
import { SITE_TITLE } from '../../../consts';
import { getSortedPosts, getTechSubcategories } from '../../../lib/posts';

const posts = (await getSortedPosts('en')).filter((post) => post.data.category === 'tech');
const subcategories = await getTechSubcategories('en');
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Tech | ${SITE_TITLE}`}
      description="Posts about software development"
      alternates={{ ko: '/tech/', en: '/en/tech/' }}
    />
  </head>
  <body>
    <Header locale="en" altHref="/tech/" />
    <main class="max-w-content mx-auto px-4 sm:px-6 py-12">
      <header class="mb-8">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-slate-100 mb-2">Tech</h1>
        <p class="text-slate-600 dark:text-slate-400">Things I learned while building · {posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
      </header>

      <div class="flex flex-wrap gap-2 mb-10">
        {subcategories.map(({ name, count }) => (
          <a
            href={`/en/tech/${name}/`}
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors"
          >
            <span>{name}</span>
            <span class="text-xs text-slate-500 dark:text-slate-500">{count}</span>
          </a>
        ))}
      </div>

      <ul class="divide-y divide-slate-100 dark:divide-slate-800/70">
        {posts.map((post) => (
          <li class="py-6 first:pt-0 last:pb-0">
            <PostCard post={post} />
          </li>
        ))}
      </ul>
    </main>
    <Footer />
  </body>
</html>
