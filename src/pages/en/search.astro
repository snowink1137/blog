---
import BaseHead from '../../astro/components/BaseHead.astro';
import Footer from '../../astro/components/Footer.astro';
import Header from '../../astro/components/Header.astro';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Search | ${SITE_TITLE}`}
      description="Search the blog"
      alternates={{ ko: '/search/', en: '/en/search/' }}
    />
    <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  </head>
  <body>
    <Header locale="en" altHref="/search/" />
    <main class="max-w-content mx-auto px-4 sm:px-6 py-12">
      <header class="mb-8">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-slate-100 mb-2">Search</h1>
        <p class="text-slate-600 dark:text-slate-400">Type a query and results will appear.</p>
      </header>

      <div id="search"></div>

      <noscript>
        <p class="mt-6 text-sm text-slate-500 dark:text-slate-400">
          Please enable JavaScript to use search.
        </p>
      </noscript>
    </main>
    <Footer />

    <script src="/pagefind/pagefind-ui.js" is:inline></script>
    <script is:inline>
      window.addEventListener('DOMContentLoaded', () => {
        if (typeof PagefindUI === 'undefined') {
          const el = document.getElementById('search');
          if (el) {
            el.innerHTML =
              '<p class="text-sm text-slate-500 dark:text-slate-400">The search index has not been built yet. It becomes available after a production build.</p>';
          }
          return;
        }
        new PagefindUI({
          element: '#search',
          showSubResults: true,
          translations: {
            placeholder: 'Search (e.g. kotlin, aws)',
            zero_results: 'No results for "[SEARCH_TERM]"',
            many_results: '[COUNT] results',
            one_result: '[COUNT] result',
            searching: 'Searching for "[SEARCH_TERM]"...',
          },
        });
      });
    </script>

    <style is:global>
      :root {
        --pagefind-ui-scale: 0.9;
        --pagefind-ui-primary: var(--color-accent);
        --pagefind-ui-text: rgb(15 23 42);
        --pagefind-ui-background: rgb(255 255 255);
        --pagefind-ui-border: rgb(226 232 240);
        --pagefind-ui-tag: rgb(241 245 249);
        --pagefind-ui-border-width: 1px;
        --pagefind-ui-border-radius: 0.5rem;
        --pagefind-ui-font: var(--font-sans);
      }
      .dark {
        --pagefind-ui-text: rgb(241 245 249);
        --pagefind-ui-background: rgb(2 6 23);
        --pagefind-ui-border: rgb(30 41 59);
        --pagefind-ui-tag: rgb(30 41 59);
      }
    </style>
  </body>
</html>
